{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "watchlist-quotes",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  // Quote cache. Before the first deploy, run `npx wrangler kv namespace create QUOTES`
  // and paste the id it prints here. Local `wrangler dev` uses a simulated store.
  "kv_namespaces": [
    { "binding": "QUOTES", "id": "1a4b18da4dbd472a80c666c142f1361e" }
  ]
  // FINNHUB_KEY and TWELVE_DATA_KEY are secrets, not vars: `npx wrangler secret put
  // FINNHUB_KEY` (and TWELVE_DATA_KEY) for production, and worker/.dev.vars
  // (gitignored) for local dev. Both /quote and /history cache in QUOTES.
}
